---
import { resolveLocale, useTranslations } from '@lib/i18n'
import { Moon, Sun } from '@lucide/astro'

const t = useTranslations(resolveLocale(Astro.currentLocale))
---

<label class="swap swap-rotate" transition:persist="theme-switch">
  <input type="checkbox" data-theme-switch aria-label={t('darkTheme')}>
  <Moon class="swap-on size-4" aria-hidden="true" />
  <Sun class="swap-off size-4" aria-hidden="true" />
</label>

<script>
import {
  getCurrentThemePreference,
  setThemePreference,
  ThemePreference,
} from '@styles/themeAppearance'

document.addEventListener('astro:before-swap', (event) => {
  event.newDocument.documentElement.setAttribute(
    'data-theme',
    getCurrentThemePreference(),
  )
})

document.addEventListener('astro:page-load', () => {
  const toggle = document.querySelector<HTMLInputElement>('[data-theme-switch]')
  if (!toggle) return

  toggle.checked = getCurrentThemePreference() === ThemePreference.dark
  toggle.onchange = () => {
    setThemePreference(
      toggle.checked ? ThemePreference.dark : ThemePreference.light,
    )
  }
})
</script>
