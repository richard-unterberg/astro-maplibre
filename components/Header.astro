---
import { getRelativeLocaleUrl } from 'astro:i18n'
import LayoutComponent from '@components/LayoutComponent.astro'
import LocaleSwitch from '@components/LocaleSwitch.astro'
import ThemeSwitch from '@components/ThemeSwitch.astro'
import { resolveLocale, useTranslations } from '@lib/i18n'
import { type Category, getCategories } from '@lib/places'
import { FaceSlightlySmiling } from '@lucide/astro'

const lang = resolveLocale(Astro.currentLocale)
const homeUrl = getRelativeLocaleUrl(lang)
const t = useTranslations(lang)
const categories: Category[] = await getCategories()
const activeCategory = Astro.params.category
const allActive = Astro.url.pathname === getRelativeLocaleUrl(lang, 'map')

const isMapPage =
  Astro.url.pathname.includes('/map/') ||
  Astro.url.pathname.includes('/category/')
---

<header class="shrink-0 min-w-0 border-b border-b-px border-b-base-300">
  <div class="bg-base-100">
    <LayoutComponent class="h-16 flex justify-between items-center gap-2">
      <a href={homeUrl} class="font-extrabold flex gap-2 items-center"
        ><FaceSlightlySmiling class="size-5" />
        <span class="hidden sm:block">astro-maplibre</span></a
      >
      <div class="flex shrink-0 items-center gap-2 sm:gap-4">
        <LocaleSwitch />
        <ThemeSwitch />
      </div>
    </LayoutComponent>
  </div>
  {isMapPage && (
    <div
      data-map-occluder="top"
      class="lg:hidden absolute top-16 h-14 z-10 w-full left-0 bg-base-300/50 dark:bg-base-100/50"
    >
      <nav aria-label={t('categories')} class="overflow-x-auto p-3">
        <ul class="flex gap-2 w-full justify-center">
          {categories.map((category) => (
            <li>
              <a
                href={getRelativeLocaleUrl(lang, `category/${category.id}`)}
                aria-current={
                  activeCategory === category.id ? 'page' : undefined
                }
                class:list={[
                  'btn btn-xs sm:btn-sm',
                  activeCategory === category.id ? 'btn-neutral' : 'btn-soft',
                ]}
              >
                {category.title[lang]}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  )}
</header>
