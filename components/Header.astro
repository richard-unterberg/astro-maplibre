---
import { getRelativeLocaleUrl } from 'astro:i18n'
import LayoutComponent from '@components/LayoutComponent.astro'
import LocaleSwitch from '@components/LocaleSwitch.astro'
import ThemeSwitch from '@components/ThemeSwitch.astro'
import { resolveLocale } from '@lib/i18n'

const homeUrl = getRelativeLocaleUrl(resolveLocale(Astro.currentLocale))
---

<header class="bg-base-200 ">
  <LayoutComponent class="h-16 flex justify-between items-center">
    <a href={homeUrl} class="font-extrabold">astro-maplibre</a>
    <div class="flex items-center gap-4">
      <LocaleSwitch />
      <ThemeSwitch />
    </div>
  </LayoutComponent>
</header>
