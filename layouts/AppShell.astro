---
import '../styles/global.css'
import { ClientRouter, fade } from 'astro:transitions'
import Header from '@components/Header.astro'
import MetaHead from '@components/MetaHead.astro'
import { getLangFromUrl } from '@lib/i18n'

const title: string = Astro.props.title
  ? `${Astro.props.title} | astro-maplibre`
  : 'astro-maplibre'

const lang = getLangFromUrl(Astro.url)
---

<html
  lang={lang}
  data-theme="dark"
  transition:animate={fade({ duration: '120ms' })}
>
  <MetaHead title={title} noRobots={Astro.props.noRobots} />
  <body>
    <Header />
    <main class="prose-container relative h-[calc(100dvh-16*var(--spacing))]">
      <slot />
    </main>
    <ClientRouter />
  </body>
</html>
