---
import '../styles/global.css'
import Header from '@components/Header.astro'
import MetaHead from '@components/MetaHead.astro'
import { resolveLocale } from '@lib/i18n'

const title: string = Astro.props.title
  ? `${Astro.props.title} | astro-maplibre`
  : 'astro-maplibre'

const description = Astro.props.description || 'astro meets maplibre'

const lang = resolveLocale(Astro.currentLocale)
---

<html lang={lang} data-theme="dark" transition:animate="none">
  <MetaHead
    title={title}
    description={description}
    robots={Astro.props.robots}
  />
  <body>
    <Header />
    <main class="prose-container relative h-[calc(100dvh-16*var(--spacing))]">
      <slot />
    </main>
  </body>
</html>
