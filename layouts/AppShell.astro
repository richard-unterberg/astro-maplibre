---
import '../styles/global.css'
import Header from '@components/Header.astro'
import MetaHead from '@components/MetaHead.astro'
import { resolveLocale } from '@lib/i18n'

const title: string = Astro.props.title
  ? `${Astro.props.title} | astro-maplibre`
  : 'astro-maplibre'

const description = Astro.props.description || 'astro meets maplibre'

const lang = resolveLocale(Astro.currentLocale)
---

<html lang={lang} data-theme="light" transition:animate="none">
  <MetaHead
    title={title}
    description={description}
    robots={Astro.props.robots}
  />
  <body class="h-dvh flex flex-col overflow-hidden">
    <Header />
    <main class="prose-container relative flex-1 min-h-0 overflow-y-auto">
      <slot />
    </main>
  </body>
</html>
