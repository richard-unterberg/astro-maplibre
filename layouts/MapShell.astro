---
import 'maplibre-gl/dist/maplibre-gl.css'
import '@map/map-controls.css'

import { getMapStyleUrl } from '@map/mapStyles'
import type { MapView } from '@map/view'
import { ThemePreference } from '@styles/themeAppearance'

interface Props {
  view: MapView
}

const { view } = Astro.props
---

<div
  class="h-full relative"
  data-map-view
  data-map-config={JSON.stringify(view)}
>
  <div
    id="map"
    class="h-full not-prose"
    transition:persist="main-map"
    data-map
    data-map-style-light={getMapStyleUrl(ThemePreference.light)}
    data-map-style-dark={getMapStyleUrl(ThemePreference.dark)}
  />
  <slot />
</div>

<script>
import { navigate } from 'astro:transitions/client'
import { createMapController } from '@map/controller'
import type { MapView } from '@map/view'
import { getCurrentThemePreference } from '@styles/themeAppearance'
import {
  Map as MapLibreMap,
  NavigationControl,
  setWorkerUrl,
} from 'maplibre-gl'
import mapWorkerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url'

setWorkerUrl(mapWorkerUrl)

let map: MapLibreMap | undefined
let themeObserver: MutationObserver | undefined
let controller: ReturnType<typeof createMapController> | undefined

document.addEventListener('astro:page-load', () => {
  const container = document.querySelector<HTMLElement>('[data-map]')
  const wrapper = document.querySelector<HTMLElement>('[data-map-view]')
  const config = wrapper?.dataset.mapConfig
  const view: MapView | undefined = config ? JSON.parse(config) : undefined

  if (map && map.getContainer() === container) {
    if (view && wrapper) controller?.setView(view, wrapper)
    return
  }

  themeObserver?.disconnect()
  controller?.destroy()
  controller = undefined
  map?.remove()
  map = undefined

  if (!container || !wrapper || !view) return

  const lightStyle = container.dataset.mapStyleLight
  const darkStyle = container.dataset.mapStyleDark
  if (!lightStyle || !darkStyle) throw new Error('Missing map styles')

  const styles = { light: lightStyle, dark: darkStyle }
  let theme = getCurrentThemePreference()

  map = new MapLibreMap({
    container,
    style: styles[theme],
    center: [12.9252, 50.8342],
    zoom: 12,
  })

  map.addControl(
    new NavigationControl({ showZoom: true, showCompass: true }),
    'top-right',
  )

  controller = createMapController(map, navigate)
  controller.setView(view, wrapper, false)

  themeObserver = new MutationObserver(() => {
    const nextTheme = getCurrentThemePreference()
    if (nextTheme === theme) return

    theme = nextTheme
    map?.setStyle(styles[theme])
  })
  themeObserver.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  })
})
</script>
