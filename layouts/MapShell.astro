---
import 'maplibre-gl/dist/maplibre-gl.css'
import '@map/map-controls.css'

import { getMapStyleUrl } from '@map/mapStyles'
import type { PlaceTarget } from '@map/placeFocus'
import { ThemePreference } from '@styles/themeAppearance'

interface Props {
  place?: PlaceTarget
}

const { place } = Astro.props
---

<div
  class="h-full relative"
  data-map-view
  data-map-place={place && JSON.stringify(place)}
>
  <div
    id="map"
    class="h-full not-prose"
    transition:persist="main-map"
    data-map
    data-map-style-light={getMapStyleUrl(ThemePreference.light)}
    data-map-style-dark={getMapStyleUrl(ThemePreference.dark)}
  />
  <slot />
</div>

<script>
import { createPlaceFocus, type PlaceTarget } from '@map/placeFocus'
import { getCurrentThemePreference } from '@styles/themeAppearance'
import {
  Map as MapLibreMap,
  Marker,
  NavigationControl,
  setWorkerUrl,
} from 'maplibre-gl'
import mapWorkerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url'

setWorkerUrl(mapWorkerUrl)

let map: MapLibreMap | undefined
let themeObserver: MutationObserver | undefined
let placeFocus: ReturnType<typeof createPlaceFocus> | undefined

document.addEventListener('astro:page-load', () => {
  const container = document.querySelector<HTMLElement>('[data-map]')
  const placeData =
    document.querySelector<HTMLElement>('[data-map-view]')?.dataset.mapPlace
  const place: PlaceTarget | undefined = placeData
    ? JSON.parse(placeData)
    : undefined

  if (map && map.getContainer() === container) {
    map.resize()
    placeFocus?.setPlace(place)
    return
  }

  themeObserver?.disconnect()
  placeFocus?.destroy()
  placeFocus = undefined
  map?.remove()
  map = undefined

  if (!container) return

  const lightStyle = container.dataset.mapStyleLight
  const darkStyle = container.dataset.mapStyleDark
  if (!lightStyle || !darkStyle) throw new Error('Missing map styles')

  const styles = { light: lightStyle, dark: darkStyle }
  let theme = getCurrentThemePreference()

  map = new MapLibreMap({
    container,
    style: styles[theme],
    center: [12.9252, 50.8342],
    zoom: 12,
  })

  map.addControl(
    new NavigationControl({ showZoom: true, showCompass: true }),
    'top-right',
  )

  const activeMap = map
  placeFocus = createPlaceFocus(activeMap, (place) => {
    const marker = new Marker().setLngLat(place.coordinates).addTo(activeMap)
    marker.getElement().setAttribute('role', 'img')
    marker.getElement().setAttribute('aria-label', place.title)
    return marker
  })
  placeFocus.setPlace(place, false)

  themeObserver = new MutationObserver(() => {
    const nextTheme = getCurrentThemePreference()
    if (nextTheme === theme) return

    theme = nextTheme
    map?.setStyle(styles[theme])
  })
  themeObserver.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  })
})
</script>
