---
import { getRelativeLocaleUrl } from 'astro:i18n'
import LayoutComponent from '@components/LayoutComponent.astro'
import Shell from '@layouts/AppShell.astro'
import MapShell from '@layouts/MapShell.astro'
import { getLocaleStaticPaths, resolveLocale, useTranslations } from '@lib/i18n'
import { localizeMapPlaces } from '@lib/mapData'
import { getPlace, getPlaces } from '@lib/places'
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'

export const prerender = true

export const getStaticPaths = (async () => {
  const places = await getPlaces()
  return (
    await Promise.all(
      places.map(async (mapPlace) => {
        const place = await getPlace(mapPlace.id)
        return getLocaleStaticPaths().map(({ params }) => ({
          params: { ...params, place: mapPlace.id },
          props: { place, mapPlace },
        }))
      }),
    )
  ).flat()
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { place, mapPlace } = Astro.props
const lang = resolveLocale(Astro.currentLocale)
const t = useTranslations(lang)
const title = place.title[lang]
const [longitude, latitude] = place.coordinates
const description = place.description[lang]
const mapUrl = getRelativeLocaleUrl(lang, 'map')
---

<Shell title={title} description={description}>
  <MapShell
    view={{
      mode: 'detail',
      selectedId: place.id,
      places: localizeMapPlaces([mapPlace], lang),
    }}
  >
    <div
      data-map-occluder
      class="max-h-1/2 absolute bottom-0 left-0 bg-base-100 w-full z-4 overflow-y-auto"
    >
      <LayoutComponent>
        <a href={mapUrl}>{t('back')}: {t('map')}</a>
        <article>
          <h1>{title}</h1>
          <p>{description}</p>
          <dl>
            <dt>{t('coordinates')} (lon, lat)</dt>
            <dd>{longitude}, {latitude}</dd>
            <dt>{t('mapZoom')}</dt>
            <dd>{place.detailZoom}</dd>
          </dl>
          <h2>{t('categories')}</h2>
          <ul>
            {place.categories.map((category) => (
              <li>
                <a href={getRelativeLocaleUrl(lang, `category/${category.id}`)}>
                  {category.title[lang]}
                </a>
                <p>{category.description[lang]}</p>
              </li>
            ))}
          </ul>
        </article>
      </LayoutComponent>
    </div>
  </MapShell>
</Shell>
