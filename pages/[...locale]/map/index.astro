---
import ShowAllEntries from '@components/ShowAllEntries.astro'
import Shell from '@layouts/AppShell.astro'
import MapShell from '@layouts/MapShell.astro'
import { getLocaleStaticPaths, resolveLocale, useTranslations } from '@lib/i18n'
import { localizeMapPlaces, overviewBounds } from '@lib/mapData'
import { getPlaces } from '@lib/places'

export const getStaticPaths = getLocaleStaticPaths
const lang = resolveLocale(Astro.currentLocale)
const t = useTranslations(lang)
const places = await getPlaces()
---

<Shell title={t('mapPage.title')} description={t('mapPage.description')}>
  <MapShell
    view={{
      mode: 'bounds',
      places: localizeMapPlaces(places, lang),
      fallbackBounds: overviewBounds(places),
    }}
  >
    <ShowAllEntries url="map/overview" />
  </MapShell>
</Shell>
